{
  "info": {
    "name": "Nowst - Criterio 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con fecha futura y horario inicialmente libre. Configurar claves locales antes de ejecutar. No compartir claves reales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "fecha",
      "value": "2026-11-27"
    },
    {
      "key": "claveChristian",
      "value": ""
    },
    {
      "key": "claveJavier",
      "value": ""
    },
    {
      "key": "claveAdmin",
      "value": ""
    },
    {
      "key": "reservaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 Salas disponibles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/salas?fecha={{fecha}}&inicio=10:00&fin=12:00&personas=4"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
