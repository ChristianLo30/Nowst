          "mode": "raw",
          "raw": "{\n  \"salaId\": 2,\n  \"personas\": 4,\n  \"horas\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
